        [ lv2:index 46 ; lv2:symbol "pan16" ; lv2:name "Pan 16" ] ,
        [ lv2:index 47 ; lv2:symbol "mute16" ; lv2:name "Mute 16" ] ,
        [ lv2:index 48 ; lv2:symbol "master" ; lv2:name "Master" ] ;
        # Output ports mod-ui streams to the pedal's JS ('change' events):
        # meters.
        modgui:monitoredOutputs
        [ lv2:symbol "level1" ] ,
        [ lv2:symbol "level2" ] ,
        [ lv2:symbol "level3" ] ,
        [ lv2:symbol "level4" ] ,
        [ lv2:symbol "level5" ] ,
        [ lv2:symbol "level6" ] ,
        [ lv2:symbol "level7" ] ,
        [ lv2:symbol "level8" ] ,
        [ lv2:symbol "level9" ] ,
        [ lv2:symbol "level10" ] ,
        [ lv2:symbol "level11" ] ,
        [ lv2:symbol "level12" ] ,
        [ lv2:symbol "level13" ] ,
        [ lv2:symbol "level14" ] ,
        [ lv2:symbol "level15" ] ,
        [ lv2:symbol "level16" ] ,
        [ lv2:symbol "level_l" ] ,
        [ lv2:symbol "level_r" ]
    ] .
